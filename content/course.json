          { "id": "for", "number": "2.1", "title": "for — the only loop", "file": "part1_tour/ch02_flow_control/01_for.md", "ref": "https://go.dev/tour/flowcontrol/1" },
          { "id": "if", "number": "2.2", "title": "if with a short statement", "file": "part1_tour/ch02_flow_control/02_if.md", "ref": "https://go.dev/tour/flowcontrol/5" },
          { "id": "switch", "number": "2.3", "title": "switch", "file": "part1_tour/ch02_flow_control/03_switch.md", "ref": "https://go.dev/tour/flowcontrol/9" },
          { "id": "defer", "number": "2.4", "title": "defer", "file": "part1_tour/ch02_flow_control/04_defer.md", "ref": "https://go.dev/tour/flowcontrol/12" }
        ]},
        { "id": "ch03_more_types", "number": 3, "title": "More types", "lessons": [
          { "id": "pointers", "number": "3.1", "title": "Pointers", "file": "part1_tour/ch03_more_types/01_pointers.md", "ref": "https://go.dev/tour/moretypes/1" },
          { "id": "structs", "number": "3.2", "title": "Structs", "file": "part1_tour/ch03_more_types/02_structs.md", "ref": "https://go.dev/tour/moretypes/2" },
          { "id": "arrays", "number": "3.3", "title": "Arrays", "file": "part1_tour/ch03_more_types/03_arrays.md", "ref": "https://go.dev/tour/moretypes/6" },
          { "id": "slices", "number": "3.4", "title": "Slices", "file": "part1_tour/ch03_more_types/04_slices.md", "ref": "https://go.dev/tour/moretypes/7" },
          { "id": "maps", "number": "3.5", "title": "Maps", "file": "part1_tour/ch03_more_types/05_maps.md", "ref": "https://go.dev/tour/moretypes/19" },
          { "id": "closures", "number": "3.6", "title": "Function values & closures", "file": "part1_tour/ch03_more_types/06_closures.md", "ref": "https://go.dev/tour/moretypes/24" }
        ]},
        { "id": "ch04_methods_interfaces", "number": 4, "title": "Methods & interfaces", "lessons": [
          { "id": "methods", "number": "4.1", "title": "Methods & receivers", "file": "part1_tour/ch04_methods_interfaces/01_methods.md", "ref": "https://go.dev/tour/methods/1" },
          { "id": "interfaces", "number": "4.2", "title": "Interfaces", "file": "part1_tour/ch04_methods_interfaces/02_interfaces.md", "ref": "https://go.dev/tour/methods/9" },
          { "id": "type_assertions", "number": "4.3", "title": "Type assertions & type switches", "file": "part1_tour/ch04_methods_interfaces/03_type_assertions.md", "ref": "https://go.dev/tour/methods/15" },
          { "id": "stringer", "number": "4.4", "title": "Stringer", "file": "part1_tour/ch04_methods_interfaces/04_stringer.md", "ref": "https://go.dev/tour/methods/17" },
          { "id": "errors", "number": "4.5", "title": "Errors", "file": "part1_tour/ch04_methods_interfaces/05_errors.md", "ref": "https://go.dev/tour/methods/19" },
          { "id": "standard_interfaces", "number": "4.6", "title": "Standard interfaces: io.Reader, image.Image", "file": "part1_tour/ch04_methods_interfaces/06_standard_interfaces.md", "ref": "https://go.dev/tour/methods/21" }
        ]},
        { "id": "ch05_generics", "number": 5, "title": "Generics", "lessons": [
          { "id": "type_parameters", "number": "5.1", "title": "Type parameters & constraints", "file": "part1_tour/ch05_generics/01_type_parameters.md", "ref": "https://go.dev/tour/generics/1" },
          { "id": "generic_types", "number": "5.2", "title": "Generic types", "file": "part1_tour/ch05_generics/02_generic_types.md", "ref": "https://go.dev/tour/generics/2" },
          { "id": "constraints", "number": "5.3", "title": "comparable, ~, constraint interfaces", "file": "part1_tour/ch05_generics/03_constraints.md", "ref": "https://go.dev/blog/intro-generics" }
        ]},
        { "id": "ch06_concurrency", "number": 6, "title": "Concurrency", "lessons": [
          { "id": "goroutines", "number": "6.1", "title": "Goroutines", "file": "part1_tour/ch06_concurrency/01_goroutines.md", "ref": "https://go.dev/tour/concurrency/1" },
          { "id": "channels", "number": "6.2", "title": "Channels & buffered channels", "file": "part1_tour/ch06_concurrency/02_channels.md", "ref": "https://go.dev/tour/concurrency/2" },
          { "id": "range_close", "number": "6.3", "title": "range & close", "file": "part1_tour/ch06_concurrency/03_range_close.md", "ref": "https://go.dev/tour/concurrency/4" },
          { "id": "select", "number": "6.4", "title": "select & default", "file": "part1_tour/ch06_concurrency/04_select.md", "ref": "https://go.dev/tour/concurrency/5" },
          { "id": "sync", "number": "6.5", "title": "sync.Mutex & sync.WaitGroup", "file": "part1_tour/ch06_concurrency/05_sync.md", "ref": "https://go.dev/tour/concurrency/9" },
          { "id": "binary_trees", "number": "6.6", "title": "Worked example: equivalent binary trees", "file": "part1_tour/ch06_concurrency/06_binary_trees.md", "ref": "https://go.dev/tour/concurrency/7" }
        ]}
      ]
    },
    {
      "id": "part2_patterns",
      "title": "Patterns & use cases",
      "chapters": [
        { "id": "errors", "title": "Errors", "lessons": [
          { "id": "wrapping", "title": "Wrapping with %w, errors.Is / errors.As", "file": "part2_patterns/errors/wrapping.md", "ref": "https://go.dev/blog/go1.13-errors", "tags": ["errors"], "problem": "Add context to an error without losing the ability to check its cause." },
          { "id": "sentinel_vs_typed", "title": "Sentinel vs typed errors", "file": "part2_patterns/errors/sentinel_vs_typed.md", "ref": "https://gobyexample.com/custom-errors", "tags": ["errors", "api-design"], "problem": "Decide how callers should distinguish one failure from another." },
          { "id": "panic_recover", "title": "panic / recover boundaries", "file": "part2_patterns/errors/panic_recover.md", "ref": "https://gobyexample.com/recover", "tags": ["errors"], "problem": "Keep one bad request from crashing the whole server." }
        ]},
        { "id": "data", "title": "Data shaping", "lessons": [
          { "id": "enums_iota", "title": "Enums with iota", "file": "part2_patterns/data/enums_iota.md", "ref": "https://gobyexample.com/enums", "tags": ["types", "constants"], "problem": "Model a fixed set of named values with type safety." },
          { "id": "struct_embedding", "title": "Struct embedding", "file": "part2_patterns/data/struct_embedding.md", "ref": "https://gobyexample.com/struct-embedding", "tags": ["types", "structs"], "problem": "Reuse fields and methods without inheritance." },
          { "id": "slice_tricks", "title": "Slice tricks: filter in place, delete, copy", "file": "part2_patterns/data/slice_tricks.md", "ref": "https://go.dev/wiki/SliceTricks", "tags": ["slices"], "problem": "Mutate slices efficiently without surprising aliasing bugs." },
          { "id": "maps_as_sets", "title": "Maps as sets", "file": "part2_patterns/data/maps_as_sets.md", "ref": "https://gobyexample.com/maps", "tags": ["maps"], "problem": "Track membership and dedupe without a Set type." },
          { "id": "json", "title": "JSON tags & marshalling", "file": "part2_patterns/data/json.md", "ref": "https://gobyexample.com/json", "tags": ["json", "structs"], "problem": "Map Go structs to and from JSON with control over field names and omission." },
          { "id": "strings_runes", "title": "Strings, runes, strings.Builder", "file": "part2_patterns/data/strings_runes.md", "ref": "https://gobyexample.com/strings-and-runes", "tags": ["strings", "unicode"], "problem": "Iterate and build text correctly with UTF-8." }
        ]},
        { "id": "concurrency", "title": "Concurrency", "lessons": [
          { "id": "worker_pool", "title": "Worker pool", "file": "part2_patterns/concurrency/worker_pool.md", "ref": "https://gobyexample.com/worker-pools", "tags": ["goroutines", "channels"], "problem": "Run N jobs on a bounded number of goroutines." },
          { "id": "pipeline", "title": "Pipeline", "file": "part2_patterns/concurrency/pipeline.md", "ref": "https://go.dev/blog/pipelines", "tags": ["goroutines", "channels"], "problem": "Chain processing stages so each runs concurrently." },
          { "id": "fan_in_fan_out", "title": "Fan-in / fan-out", "file": "part2_patterns/concurrency/fan_in_fan_out.md", "ref": "https://go.dev/blog/pipelines", "tags": ["goroutines", "channels"], "problem": "Spread work across goroutines and merge the results into one stream." },
          { "id": "select_timeout", "title": "select with timeout", "file": "part2_patterns/concurrency/select_timeout.md", "ref": "https://gobyexample.com/timeouts", "tags": ["channels", "select"], "problem": "Give up on a slow operation instead of blocking forever." },
          { "id": "context_cancellation", "title": "context cancellation", "file": "part2_patterns/concurrency/context_cancellation.md", "ref": "https://gobyexample.com/context", "tags": ["context", "goroutines"], "problem": "Stop a tree of goroutines when the caller goes away." },
          { "id": "errgroup", "title": "errgroup", "file": "part2_patterns/concurrency/errgroup.md", "ref": "https://pkg.go.dev/golang.org/x/sync/errgroup", "tags": ["goroutines", "errors"], "problem": "Run tasks concurrently and return the first error." },
          { "id": "rate_limiting", "title": "Rate limiting", "file": "part2_patterns/concurrency/rate_limiting.md", "ref": "https://gobyexample.com/rate-limiting", "tags": ["channels", "time"], "problem": "Cap how often something happens." },
          { "id": "mutex_vs_channel", "title": "Mutex vs channel", "file": "part2_patterns/concurrency/mutex_vs_channel.md", "ref": "https://go.dev/wiki/MutexOrChannel", "tags": ["sync", "channels"], "problem": "Pick the right tool to protect shared state." }
        ]},
        { "id": "io", "title": "I/O & files", "lessons": [
          { "id": "reading_files", "title": "Reading files with bufio", "file": "part2_patterns/io/reading_files.md", "ref": "https://gobyexample.com/reading-files", "tags": ["io", "files"], "problem": "Read a file line by line without loading it all." },
          { "id": "writing_files", "title": "Writing files atomically", "file": "part2_patterns/io/writing_files.md", "ref": "https://gobyexample.com/writing-files", "tags": ["io", "files"], "problem": "Replace a file after writing it, with explicit platform and durability limits." },
          { "id": "embed", "title": "//go:embed", "file": "part2_patterns/io/embed.md", "ref": "https://gobyexample.com/embed-directive", "tags": ["io", "build"], "problem": "Ship static assets inside the binary." }
        ]},
        { "id": "http", "title": "HTTP", "lessons": [
          { "id": "server_mux", "title": "Server with http.ServeMux", "file": "part2_patterns/http/server_mux.md", "ref": "https://gobyexample.com/http-server", "tags": ["http"], "problem": "Serve routes with the standard library only." },
          { "id": "client_timeouts", "title": "Client with timeouts", "file": "part2_patterns/http/client_timeouts.md", "ref": "https://gobyexample.com/http-client", "tags": ["http", "context"], "problem": "Call an API without hanging forever." },
          { "id": "json_api", "title": "JSON API handler", "file": "part2_patterns/http/json_api.md", "ref": "https://pkg.go.dev/encoding/json", "tags": ["http", "json"], "problem": "Decode a request body, validate, and encode a response." },
          { "id": "middleware", "title": "Middleware", "file": "part2_patterns/http/middleware.md", "ref": "https://pkg.go.dev/net/http#Handler", "tags": ["http"], "problem": "Add logging, auth, or recovery around every handler." },
          { "id": "graceful_shutdown", "title": "Graceful shutdown", "file": "part2_patterns/http/graceful_shutdown.md", "ref": "https://pkg.go.dev/net/http#Server.Shutdown", "tags": ["http", "context", "signals"], "problem": "Finish in-flight requests when the process is told to stop." }
        ]},
        { "id": "testing", "title": "Testing", "lessons": [
          { "id": "table_driven", "title": "Table-driven tests", "file": "part2_patterns/testing/table_driven.md", "ref": "https://go.dev/wiki/TableDrivenTests", "tags": ["testing"], "problem": "Cover many inputs without copy-pasting test functions." },
          { "id": "subtests_helpers", "title": "Subtests & t.Helper", "file": "part2_patterns/testing/subtests_helpers.md", "ref": "https://go.dev/blog/subtests", "tags": ["testing"], "problem": "Name cases, run one of them, and keep failure lines useful." },
          { "id": "httptest", "title": "httptest", "file": "part2_patterns/testing/httptest.md", "ref": "https://pkg.go.dev/net/http/httptest", "tags": ["testing", "http"], "problem": "Test handlers and clients without an external service." },
          { "id": "golden_files", "title": "Golden files", "file": "part2_patterns/testing/golden_files.md", "ref": "https://pkg.go.dev/testing", "tags": ["testing"], "problem": "Assert large outputs by comparing against a stored file." },
          { "id": "benchmarks_fuzz", "title": "Benchmarks & fuzzing", "file": "part2_patterns/testing/benchmarks_fuzz.md", "ref": "https://go.dev/doc/tutorial/fuzz", "tags": ["testing", "performance"], "problem": "Measure speed and let the tool find inputs that break you." }
        ]},
        { "id": "project", "title": "Project & API design", "lessons": [
          { "id": "module_layout", "title": "Module layout", "file": "part2_patterns/project/module_layout.md", "ref": "https://go.dev/doc/modules/layout", "tags": ["modules", "project"], "problem": "Organise packages so the repo stays navigable." },
          { "id": "functional_options", "title": "Functional options", "file": "part2_patterns/project/functional_options.md", "ref": "https://dave.cheney.net/2014/10/17/functional-options-for-friendly-apis", "tags": ["api-design"], "problem": "Offer optional configuration without a giant constructor." },
          { "id": "zero_values", "title": "Constructors & useful zero values", "file": "part2_patterns/project/zero_values.md", "ref": "https://go.dev/doc/effective_go#data", "tags": ["api-design", "types"], "problem": "Make types usable without an init step." },
          { "id": "small_interfaces", "title": "Small, consumer-side interfaces", "file": "part2_patterns/project/small_interfaces.md", "ref": "https://go.dev/doc/effective_go#interfaces_and_types", "tags": ["api-design", "interfaces"], "problem": "Depend on behaviour you need, not on concrete types." }
        ]},
        { "id": "large_service", "title": "Structuring a large Go service", "lessons": [
          {"id": "boundaries", "title": "Structuring a large Go service", "file": "part2_patterns/large_service/boundaries.md", "ref": "https://go.dev/doc/modules/layout", "tags": ["project", "architecture"], "problem": "Choose package boundaries for a service with multiple domains."},
          {"id": "endpoints", "title": "Multiple endpoints with one application", "file": "part2_patterns/large_service/endpoints.md", "ref": "https://pkg.go.dev/net/http#ServeMux", "tags": ["http", "architecture"], "problem": "Organize routes, handlers, validation, and error responses."},
          {"id": "shared_clients", "title": "Shared external clients", "file": "part2_patterns/large_service/shared_clients.md", "ref": "https://pkg.go.dev/net/http#Client", "tags": ["http", "interfaces", "architecture"], "problem": "Reuse external clients across domains with explicit ownership."},
          {"id": "cross_domain", "title": "Cross-domain workflows", "file": "part2_patterns/large_service/cross_domain.md", "ref": "https://go.dev/wiki/CodeReviewComments#interfaces", "tags": ["interfaces", "architecture"], "problem": "Coordinate domains through small contracts without import cycles."},
          {"id": "shared_libraries", "title": "Shared libraries with clear owners", "file": "part2_patterns/large_service/shared_libraries.md", "ref": "https://go.dev/doc/modules/layout", "tags": ["modules", "api-design", "architecture"], "problem": "Share stable behavior without coupling unrelated domains."},
          {"id": "testing_frameworks", "title": "Testing and framework choices", "file": "part2_patterns/large_service/testing_frameworks.md", "ref": "https://uber-go.github.io/fx/", "tags": ["testing", "http", "architecture"], "problem": "Verify boundaries and compare standard Go, chi, and Fx."}
        ]}
      ]
    },
    {
      "id": "part3_toolchain",
      "title": "Toolchain",
      "chapters": [
        { "id": "go_cli", "title": "The go command", "lessons": [
          { "id": "build_run_install", "title": "build / run / install", "file": "part3_toolchain/01_build_run_install.md", "ref": "https://pkg.go.dev/cmd/go#hdr-Compile_packages_and_dependencies" },
          { "id": "modules", "title": "Modules: tidy, why, vendor, work", "file": "part3_toolchain/02_modules.md", "ref": "https://go.dev/ref/mod" },
          { "id": "test", "title": "go test: run, bench, cover, race, fuzz", "file": "part3_toolchain/03_test.md", "ref": "https://pkg.go.dev/cmd/go#hdr-Testing_flags" },
          { "id": "fmt_vet_lint", "title": "fmt / vet / lint", "file": "part3_toolchain/04_fmt_vet_lint.md", "ref": "https://pkg.go.dev/cmd/vet" },
          { "id": "tooling", "title": "doc, generate, pprof, trace, gopls", "file": "part3_toolchain/05_tooling.md", "ref": "https://go.dev/blog/pprof" },
          { "id": "cross_compile", "title": "Cross-compile & release", "file": "part3_toolchain/06_cross_compile.md", "ref": "https://go.dev/doc/install/source#environment" }
        ]}
      ]
    }
  ]
}

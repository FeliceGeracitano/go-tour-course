          { "id": "modules_quick_start", "number": "0.2", "title": "Modules quick start", "file": "part1_tour/ch00_getting_started/02_modules_quick_start.md", "ref": "https://go.dev/doc/tutorial/create-module" },
          { "id": "how_to_use", "number": "0.3", "title": "How to use this course", "file": "part1_tour/ch00_getting_started/03_how_to_use.md", "ref": "https://go.dev/tour/welcome/1" }
        ]},
        { "id": "ch01_basics", "number": 1, "title": "Packages, variables, functions", "lessons": [
          { "id": "packages_imports", "number": "1.1", "title": "Packages, imports, exported names", "file": "part1_tour/ch01_basics/01_packages_imports.md", "ref": "https://go.dev/tour/basics/1" },
          { "id": "functions", "number": "1.2", "title": "Functions & multiple results", "file": "part1_tour/ch01_basics/02_functions.md", "ref": "https://go.dev/tour/basics/4" },
          { "id": "variables", "number": "1.3", "title": "Variables", "file": "part1_tour/ch01_basics/03_variables.md", "ref": "https://go.dev/tour/basics/8" },
          { "id": "basic_types", "number": "1.4", "title": "Basic types, zero values, conversions", "file": "part1_tour/ch01_basics/04_basic_types.md", "ref": "https://go.dev/tour/basics/11" },
          { "id": "constants", "number": "1.5", "title": "Constants & iota", "file": "part1_tour/ch01_basics/05_constants.md", "ref": "https://go.dev/tour/basics/15" }
        ]},
